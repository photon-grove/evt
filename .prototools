actionlint = "~1.7"
# Keep bun and deno in step with the TypeScript job in .github/workflows/ci.yml.
bun = "1.4.3"
deno = "2.9.6"
go = "1.26.4"
golangci-lint = "2.12.2"
moon = "2.6.5"
node = "~24.5"
npm = "~11.7"
pnpm = "~10"
terraform = "~1.14"

[settings]
auto-install = true

[plugins.tools]
"actionlint" = "source:./.github/proto-plugins/actionlint.toml"
"golangci-lint" = "https://raw.githubusercontent.com/b4nst/proto-plugins/refs/heads/main/toml/golangci-lint.toml"
"terraform" = "source:./.github/proto-plugins/terraform.toml"
