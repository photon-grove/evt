{
  "scenarios": [
    {
      "name": "metadata-extensions",
      "description": "Both writers persist C6 principal, explicit and defaulted causation, and extensions; both readers verify every field against the golden fixtures.",
      "snapshotInterval": 0,
      "steps": [
        { "by": "go", "op": "execute", "commandId": "c1", "principalId": "user:42", "causationId": "upstream-go", "extensions": { "source": "cli", "empty": "" }, "command": { "type": "open", "owner": "Alex" }, "expect": { "result": "ok", "events": 1 } },
        { "by": "rust", "op": "execute", "commandId": "c2", "principalId": "user:43", "causationId": "upstream-rust", "extensions": { "tenant": "example", "source": "api" }, "command": { "type": "deposit", "amountCents": 10 }, "expect": { "result": "ok", "events": 1 } },
        { "by": "go", "op": "execute", "commandId": "c3", "principalId": "user:42", "command": { "type": "deposit", "amountCents": 20 }, "expect": { "result": "ok", "events": 1 } },
        { "by": "rust", "op": "execute", "commandId": "c4", "principalId": "user:43", "command": { "type": "deposit", "amountCents": 30 }, "expect": { "result": "ok", "events": 1 } }
      ]
    },
    {
      "name": "go-writes-rust-reads",
      "description": "Go writes the whole stream, including two snapshots; Rust must load and verify it.",
      "snapshotInterval": 3,
      "steps": [
        { "by": "go", "op": "execute", "commandId": "c1", "command": { "type": "open", "owner": "Ada Lovelace", "openedAt": "2026-01-02T03:04:05.123Z" }, "expect": { "result": "ok", "events": 1 } },
        { "by": "go", "op": "execute", "commandId": "c2", "command": { "type": "deposit", "amountCents": 1500, "memo": "Coffee & <cake>" }, "expect": { "result": "ok", "events": 1 } },
        { "by": "go", "op": "execute", "commandId": "c3", "command": { "type": "batchDeposit", "amounts": [100, 200, 300] }, "expect": { "result": "ok", "events": 3 } },
        { "by": "go", "op": "execute", "commandId": "c4", "command": { "type": "tag", "tags": ["vip", "early-adopter"] }, "expect": { "result": "ok", "events": 1 } },
        { "by": "go", "op": "execute", "commandId": "c5", "command": { "type": "setLabels", "labels": { "tier": "gold", "region": "emea" } }, "expect": { "result": "ok", "events": 1 } },
        { "by": "go", "op": "execute", "commandId": "c6", "command": { "type": "withdraw", "amountCents": 600 }, "expect": { "result": "ok", "events": 1 } },
        { "by": "go", "op": "execute", "commandId": "c7", "command": { "type": "rename", "owner": "Ada King" }, "expect": { "result": "ok", "events": 1 } }
      ]
    },
    {
      "name": "rust-writes-go-reads",
      "description": "The mirror image: Rust writes the whole stream; Go must load and verify it.",
      "snapshotInterval": 3,
      "steps": [
        { "by": "rust", "op": "execute", "commandId": "c1", "command": { "type": "open", "owner": "Ada Lovelace", "openedAt": "2026-01-02T03:04:05.123Z" }, "expect": { "result": "ok", "events": 1 } },
        { "by": "rust", "op": "execute", "commandId": "c2", "command": { "type": "deposit", "amountCents": 1500, "memo": "Coffee & <cake>" }, "expect": { "result": "ok", "events": 1 } },
        { "by": "rust", "op": "execute", "commandId": "c3", "command": { "type": "batchDeposit", "amounts": [100, 200, 300] }, "expect": { "result": "ok", "events": 3 } },
        { "by": "rust", "op": "execute", "commandId": "c4", "command": { "type": "tag", "tags": ["vip", "early-adopter"] }, "expect": { "result": "ok", "events": 1 } },
        { "by": "rust", "op": "execute", "commandId": "c5", "command": { "type": "setLabels", "labels": { "tier": "gold", "region": "emea" } }, "expect": { "result": "ok", "events": 1 } },
        { "by": "rust", "op": "execute", "commandId": "c6", "command": { "type": "withdraw", "amountCents": 600 }, "expect": { "result": "ok", "events": 1 } },
        { "by": "rust", "op": "execute", "commandId": "c7", "command": { "type": "rename", "owner": "Ada King" }, "expect": { "result": "ok", "events": 1 } }
      ]
    },
    {
      "name": "interleaved",
      "description": "Writers alternate on every step, so each language extends a stream and a snapshot chain the other started. Covers trace and address metadata, non-ASCII and HTML-sensitive text, map key ordering, rejections, and a closed account.",
      "snapshotInterval": 2,
      "steps": [
        { "by": "go", "op": "execute", "commandId": "c1", "command": { "type": "open", "owner": "Grace Hopper", "openedAt": "2026-03-04T05:06:07Z" }, "expect": { "result": "ok", "events": 1 } },
        { "by": "rust", "op": "execute", "commandId": "c2", "trace": { "traceparent": "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01", "tracestate": "vendor=a" }, "command": { "type": "deposit", "amountCents": 2500, "memo": "Paycheck \u2615 \u2028 \u2029 <tab>\t&" }, "expect": { "result": "ok", "events": 1 } },
        { "by": "go", "op": "execute", "commandId": "c3", "address": "198.51.100.4", "command": { "type": "deposit", "amountCents": 100 }, "expect": { "result": "ok", "events": 1 } },
        { "by": "rust", "op": "execute", "commandId": "c4", "command": { "type": "withdraw", "amountCents": 99999 }, "expect": { "result": "rejected" } },
        { "by": "go", "op": "execute", "commandId": "c5", "timestamp": "2026-10-12T01:02:03Z", "command": { "type": "withdraw", "amountCents": 600 }, "expect": { "result": "ok", "events": 1 } },
        { "by": "rust", "op": "execute", "commandId": "c6", "command": { "type": "tag", "tags": ["café", "naïve", "漢字"] }, "expect": { "result": "ok", "events": 1 } },
        { "by": "go", "op": "execute", "commandId": "c7", "command": { "type": "setLabels", "labels": { "z": "last", "a": "first", "m": "middle" } }, "expect": { "result": "ok", "events": 1 } },
        { "by": "rust", "op": "execute", "commitId": "compat-rust-manual", "command": { "type": "setLabels", "labels": { "b": "second" } }, "expect": { "result": "ok", "events": 1 } },
        { "by": "go", "op": "execute", "commandId": "c9", "command": { "type": "close", "reason": "customer request" }, "expect": { "result": "ok", "events": 1 } },
        { "by": "rust", "op": "execute", "commandId": "c10", "command": { "type": "deposit", "amountCents": 5 }, "expect": { "result": "rejected" } }
      ]
    },
    {
      "name": "compaction-handoff",
      "description": "One language compacts a stream the other wrote, the other keeps writing from the snapshot, compaction stays idempotent and refuses ranges no snapshot covers, and neither language can write a sequence the snapshot covers after its event was compacted.",
      "snapshotInterval": 3,
      "steps": [
        { "by": "go", "op": "execute", "commandId": "c1", "command": { "type": "open", "owner": "Katherine Johnson" }, "expect": { "result": "ok", "events": 1 } },
        { "by": "go", "op": "execute", "commandId": "c2", "command": { "type": "batchDeposit", "amounts": [10, 20, 30] }, "expect": { "result": "ok", "events": 3 } },
        { "by": "rust", "op": "compact", "through": 4, "expect": { "result": "compacted", "deleted": 4 } },
        { "by": "rust", "op": "compact", "through": 4, "expect": { "result": "compacted" } },
        { "by": "go", "op": "compact", "through": 5, "expect": { "result": "uncovered" } },
        { "by": "rust", "op": "execute", "commandId": "c3", "command": { "type": "deposit", "amountCents": 40 }, "expect": { "result": "ok", "events": 1 } },
        { "by": "go", "op": "execute", "commandId": "c4", "command": { "type": "deposit", "amountCents": 50 }, "expect": { "result": "ok", "events": 1 } },
        { "by": "go", "op": "compact", "through": 6, "expect": { "result": "compacted", "deleted": 2 } },
        { "by": "rust", "op": "execute", "commandId": "c5", "command": { "type": "withdraw", "amountCents": 15 }, "expect": { "result": "ok", "events": 1 } },
        { "by": "rust", "op": "compact", "through": 7, "expect": { "result": "uncovered" } },
        { "by": "go", "op": "conflictProbe", "sequence": 7, "expect": { "result": "conflict" } },
        { "by": "rust", "op": "conflictProbe", "sequence": 2, "expect": { "result": "conflict" } },
        { "by": "go", "op": "conflictProbe", "sequence": 5, "expect": { "result": "conflict" } }
      ]
    },
    {
      "name": "upcast-legacy",
      "description": "Each language appends a legacy account:renamed v1 event ({\"name\": ...}) and the other must upcast it to v2 ({\"owner\": ...}) on load, including into a snapshot.",
      "snapshotInterval": 3,
      "steps": [
        { "by": "go", "op": "execute", "commandId": "c1", "command": { "type": "open", "owner": "Original" }, "expect": { "result": "ok", "events": 1 } },
        { "by": "rust", "op": "appendRaw", "commandId": "c2", "event": { "type": "account:renamed", "version": 1, "payload": "{\"name\":\"Legacy From Rust\"}" }, "expect": { "result": "ok", "events": 1 } },
        { "by": "go", "op": "execute", "commandId": "c3", "command": { "type": "deposit", "amountCents": 10 }, "expect": { "result": "ok", "events": 1 } },
        { "by": "go", "op": "appendRaw", "commandId": "c4", "event": { "type": "account:renamed", "version": 1, "payload": "{\"name\":\"Legacy From Go\"}" }, "expect": { "result": "ok", "events": 1 } },
        { "by": "rust", "op": "execute", "commandId": "c5", "command": { "type": "deposit", "amountCents": 20 }, "expect": { "result": "ok", "events": 1 } },
        { "by": "rust", "op": "execute", "commandId": "c6", "command": { "type": "rename", "owner": "Modern" }, "expect": { "result": "ok", "events": 1 } }
      ]
    },
    {
      "name": "conflict-probe",
      "description": "Both languages detect writes to an existing sequence written by the other, and accept a write at the next free sequence.",
      "snapshotInterval": 5,
      "steps": [
        { "by": "go", "op": "execute", "commandId": "c1", "command": { "type": "open", "owner": "Mary Jackson" }, "expect": { "result": "ok", "events": 1 } },
        { "by": "rust", "op": "conflictProbe", "sequence": 1, "expect": { "result": "conflict" } },
        { "by": "go", "op": "conflictProbe", "sequence": 1, "expect": { "result": "conflict" } },
        { "by": "rust", "op": "execute", "commandId": "c2", "command": { "type": "deposit", "amountCents": 75 }, "expect": { "result": "ok", "events": 1 } },
        { "by": "go", "op": "conflictProbe", "sequence": 2, "expect": { "result": "conflict" } },
        { "by": "rust", "op": "conflictProbe", "sequence": 3, "expect": { "result": "ok", "events": 1 } },
        { "by": "go", "op": "execute", "commandId": "c3", "command": { "type": "deposit", "amountCents": 5 }, "expect": { "result": "ok", "events": 1 } }
      ]
    },
    {
      "name": "dedupe-window",
      "description": "A command ID recorded after the latest snapshot is a duplicate in both languages. Command IDs folded into a snapshot are no longer checked, so the same ID executes again.",
      "snapshotInterval": 5,
      "steps": [
        { "by": "go", "op": "execute", "commandId": "c1", "command": { "type": "open", "owner": "Dorothy Vaughan" }, "expect": { "result": "ok", "events": 1 } },
        { "by": "rust", "op": "execute", "commandId": "c2", "command": { "type": "deposit", "amountCents": 100 }, "expect": { "result": "ok", "events": 1 } },
        { "by": "go", "op": "execute", "commandId": "c2", "command": { "type": "deposit", "amountCents": 100 }, "expect": { "result": "duplicate" } },
        { "by": "rust", "op": "execute", "commandId": "c2", "command": { "type": "deposit", "amountCents": 100 }, "expect": { "result": "duplicate" } },
        { "by": "go", "op": "execute", "commandId": "c3", "command": { "type": "deposit", "amountCents": 50 }, "expect": { "result": "ok", "events": 1 } },
        { "by": "rust", "op": "execute", "commandId": "c4", "command": { "type": "tag", "tags": ["x"] }, "expect": { "result": "ok", "events": 1 } },
        { "by": "go", "op": "execute", "commandId": "c5", "command": { "type": "setLabels", "labels": { "k": "v" } }, "expect": { "result": "ok", "events": 1 } },
        { "by": "rust", "op": "execute", "commandId": "c2", "command": { "type": "deposit", "amountCents": 100 }, "expect": { "result": "ok", "events": 1 } },
        { "by": "go", "op": "execute", "commandId": "c6", "command": { "type": "deposit", "amountCents": 100 }, "expect": { "result": "ok", "events": 1 } },
        { "by": "rust", "op": "execute", "commandId": "c6", "command": { "type": "deposit", "amountCents": 1 }, "expect": { "result": "duplicate" } }
      ]
    },
    {
      "name": "batch-crosses-snapshot",
      "description": "A multi-event command that crosses the snapshot interval snapshots the whole batch, so the snapshot's eventSeq is the batch's last event.",
      "snapshotInterval": 4,
      "steps": [
        { "by": "go", "op": "execute", "commandId": "c1", "command": { "type": "open", "owner": "Hedy Lamarr" }, "expect": { "result": "ok", "events": 1 } },
        { "by": "rust", "op": "execute", "commandId": "c2", "command": { "type": "batchDeposit", "amounts": [1, 2, 3, 4, 5, 6] }, "expect": { "result": "ok", "events": 6 } },
        { "by": "go", "op": "execute", "commandId": "c3", "command": { "type": "batchDeposit", "amounts": [7] }, "expect": { "result": "ok", "events": 1 } },
        { "by": "rust", "op": "execute", "commandId": "c4", "command": { "type": "batchDeposit", "amounts": [8, 9, 10] }, "expect": { "result": "ok", "events": 3 } },
        { "by": "go", "op": "execute", "commandId": "c5", "command": { "type": "batchDeposit", "amounts": [11, 12, 13, 14, 15] }, "expect": { "result": "ok", "events": 5 } }
      ]
    },
    {
      "name": "snapshots-disabled",
      "description": "With snapshots disabled, neither language writes a snapshot row and every load replays from sequence 1.",
      "snapshotInterval": 0,
      "steps": [
        { "by": "go", "op": "execute", "commandId": "c1", "command": { "type": "open", "owner": "Radia Perlman" }, "expect": { "result": "ok", "events": 1 } },
        { "by": "rust", "op": "execute", "commandId": "c2", "command": { "type": "deposit", "amountCents": 300, "memo": "first" }, "expect": { "result": "ok", "events": 1 } },
        { "by": "go", "op": "execute", "commandId": "c3", "command": { "type": "deposit", "amountCents": 200, "memo": "second" }, "expect": { "result": "ok", "events": 1 } },
        { "by": "rust", "op": "execute", "commandId": "c4", "command": { "type": "deposit", "amountCents": 100 }, "expect": { "result": "ok", "events": 1 } },
        { "by": "go", "op": "execute", "commandId": "c5", "command": { "type": "withdraw", "amountCents": 250 }, "expect": { "result": "ok", "events": 1 } },
        { "by": "rust", "op": "execute", "commandId": "c6", "command": { "type": "tag", "tags": ["no-snapshots"] }, "expect": { "result": "ok", "events": 1 } }
      ]
    },
    {
      "name": "multi-stream",
      "description": "Both writers atomically append to several streams in one commit. A collision in one stream leaves every other stream and snapshot unchanged, and a transactional snapshot covers its stream's last event.",
      "snapshotInterval": 0,
      "steps": [
        { "by": "go", "op": "execute", "commandId": "c1", "command": { "type": "open", "owner": "Grace Hopper" }, "expect": { "result": "ok", "events": 1 } },
        { "by": "rust", "op": "transaction", "commandId": "c2", "streams": [
            { "suffix": "", "sequence": 2, "events": [{ "type": "account:deposited", "version": 1, "payload": "{\"amountCents\":500,\"memo\":\"primary\"}" }] },
            { "suffix": "ledger", "sequence": 1, "events": [{ "type": "account:deposited", "version": 1, "payload": "{\"amountCents\":50,\"memo\":\"sibling\"}" }] }
          ], "expect": { "result": "ok", "events": 2 } },
        { "by": "go", "op": "transaction", "commandId": "c3", "streams": [
            { "suffix": "ledger", "sequence": 2, "events": [{ "type": "account:deposited", "version": 1, "payload": "{\"amountCents\":60}" }] },
            { "suffix": "", "sequence": 3, "events": [{ "type": "account:deposited", "version": 1, "payload": "{\"amountCents\":600}" }] }
          ], "expect": { "result": "ok", "events": 2 } },
        { "by": "rust", "op": "transaction", "commandId": "c4", "streams": [
            { "suffix": "", "sequence": 4, "events": [{ "type": "account:deposited", "version": 1, "payload": "{\"amountCents\":700}" }] },
            { "suffix": "ledger", "sequence": 1, "events": [{ "type": "account:deposited", "version": 1, "payload": "{\"amountCents\":70,\"memo\":\"collides\"}" }] }
          ], "expect": { "result": "conflict" } },
        { "by": "go", "op": "execute", "commandId": "c5", "command": { "type": "deposit", "amountCents": 800, "memo": "after-failure" }, "expect": { "result": "ok", "events": 1 } },
        { "by": "rust", "op": "transaction", "commandId": "c6", "streams": [
            { "suffix": "", "sequence": 5, "events": [{ "type": "account:deposited", "version": 1, "payload": "{\"amountCents\":900,\"memo\":\"snapshotted\"}" }], "snapshot": { "sequence": 1, "payload": "{\"owner\":\"Grace Hopper\",\"status\":\"open\",\"balanceCents\":3050,\"deposits\":5,\"openedAt\":\"2026-01-02T03:04:05.123Z\",\"tags\":null,\"labels\":null,\"lastMemo\":\"snapshotted\"}" } }
          ], "expect": { "result": "ok", "events": 1 } }
      ]
    },
    {
      "name": "read-fences",
      "description": "Fences protect read-only streams: an engine fence at the head passes, a stale head fails, and the compaction ABA (append, snapshot, compact) still fails a stale fence, because the head only increases.",
      "snapshotInterval": 0,
      "steps": [
        { "by": "go", "op": "execute", "commandId": "c1", "command": { "type": "open", "owner": "Katherine Johnson" }, "expect": { "result": "ok", "events": 1 } },
        { "by": "rust", "op": "transaction", "commandId": "c2", "streams": [
            { "suffix": "", "sequence": 2, "events": [{ "type": "account:deposited", "version": 1, "payload": "{\"amountCents\":100}" }] },
            { "suffix": "watched", "sequence": 1, "events": [{ "type": "account:deposited", "version": 1, "payload": "{\"amountCents\":10,\"memo\":\"watched\"}" }] }
          ], "expect": { "result": "ok", "events": 2 } },
        { "by": "go", "op": "transaction", "commandId": "c3", "streams": [
            { "suffix": "", "sequence": 3, "events": [{ "type": "account:deposited", "version": 1, "payload": "{\"amountCents\":200}" }] }
          ], "fences": [
            { "suffix": "watched", "head": 1, "callerStamped": true },
            { "suffix": "absent", "head": 0 }
          ], "expect": { "result": "ok", "events": 1 } },
        { "by": "rust", "op": "transaction", "commandId": "c4", "streams": [
            { "suffix": "", "sequence": 4, "events": [{ "type": "account:deposited", "version": 1, "payload": "{\"amountCents\":300}" }] }
          ], "fences": [
            { "suffix": "watched", "head": 0, "callerStamped": true }
          ], "expect": { "result": "conflict" } },
        { "by": "go", "op": "transaction", "commandId": "c5", "streams": [
            { "suffix": "", "sequence": 4, "events": [{ "type": "account:deposited", "version": 1, "payload": "{\"amountCents\":400}" }] },
            { "suffix": "watched", "sequence": 2, "events": [{ "type": "account:deposited", "version": 1, "payload": "{\"amountCents\":20,\"memo\":\"appended\"}" }], "snapshot": { "sequence": 1, "payload": "{\"owner\":\"Katherine Johnson\",\"status\":\"open\",\"balanceCents\":30,\"deposits\":2,\"openedAt\":\"2026-01-02T03:04:05.123Z\",\"tags\":null,\"labels\":null,\"lastMemo\":\"appended\"}" } }
          ], "expect": { "result": "ok", "events": 2 } },
        { "by": "go", "op": "compact", "through": 2, "suffix": "watched", "expect": { "result": "compacted", "deleted": 2 } },
        { "by": "rust", "op": "transaction", "commandId": "c6", "streams": [
            { "suffix": "", "sequence": 5, "events": [{ "type": "account:deposited", "version": 1, "payload": "{\"amountCents\":500}" }] }
          ], "fences": [
            { "suffix": "watched", "head": 1, "callerStamped": true }
          ], "expect": { "result": "conflict" } },
        { "by": "rust", "op": "appendRaw", "commandId": "c7", "suffix": "watched", "event": { "type": "account:deposited", "version": 1, "payload": "{\"amountCents\":20,\"memo\":\"after-aba\"}" }, "expect": { "result": "ok", "events": 1 } }
      ]
    },
    {
      "name": "outcomes-idempotency",
      "description": "A retry with the same identity digest returns the stored outcome and writes nothing, across languages and across snapshots; a different payload or principal under the same ID is IdempotencyKeyReuse; a command ID over 512 UTF-8 bytes fails with CommandIdTooLong before any write.",
      "snapshotInterval": 3,
      "outcomes": true,
      "steps": [
        { "by": "go", "op": "execute", "commandId": "c1", "command": { "type": "open", "owner": "Ada Lovelace", "openedAt": "2026-01-02T03:04:05.123Z" }, "expect": { "result": "ok", "events": 1 } },
        { "by": "rust", "op": "execute", "commandId": "c2", "command": { "type": "deposit", "amountCents": 500, "memo": "first" }, "expect": { "result": "ok", "events": 1 } },
        { "by": "go", "op": "execute", "commandId": "c2", "command": { "type": "deposit", "amountCents": 500, "memo": "first" }, "expect": { "result": "ok", "events": 1, "replayed": true } },
        { "by": "rust", "op": "execute", "commandId": "c2", "command": { "type": "deposit", "amountCents": 600, "memo": "first" }, "expect": { "result": "reuse" } },
        { "by": "go", "op": "execute", "commandId": "c3", "command": { "type": "batchDeposit", "amounts": [100, 200] }, "expect": { "result": "ok", "events": 2 } },
        { "by": "rust", "op": "execute", "commandId": "c4", "principalId": "user:42", "command": { "type": "deposit", "amountCents": 50 }, "expect": { "result": "ok", "events": 1 } },
        { "by": "go", "op": "execute", "commandId": "c4", "principalId": "user:43", "command": { "type": "deposit", "amountCents": 50 }, "expect": { "result": "reuse" } },
        { "by": "go", "op": "execute", "commandId": "c4", "principalId": "user:42", "command": { "type": "deposit", "amountCents": 50 }, "expect": { "result": "ok", "events": 1, "replayed": true } },
