  "postgresSchemas": [
    {
      "eventsTable": "orders",
      "snapshotsTable": "orders_entity_type_idx",
      "ddl": "\nCREATE TABLE IF NOT EXISTS orders (\n    entity_id   text   NOT NULL,\n    sequence    bigint NOT NULL,\n    event_id    text   NOT NULL,\n    event_type  text   NOT NULL,\n    version     bigint NOT NULL,\n    entity_type text   NOT NULL,\n    payload     bytea  NOT NULL,\n    metadata    jsonb  NOT NULL DEFAULT '{}'::jsonb,\n    created_at  timestamptz NOT NULL DEFAULT now(),\n    PRIMARY KEY (entity_id, sequence)\n);\nCREATE INDEX IF NOT EXISTS orders__evt_entity_type_idx ON orders (entity_type);\nDO $$\nBEGIN\n    IF EXISTS (\n        SELECT 1 FROM pg_index\n        WHERE indexrelid = to_regclass('orders_entity_type_idx')\n          AND indrelid = 'orders'::regclass\n    ) THEN\n        DROP INDEX orders_entity_type_idx;\n    END IF;\nEND $$;\n\nCREATE TABLE IF NOT EXISTS orders_entity_type_idx (\n    entity_id      text   PRIMARY KEY,\n    entity_type    text   NOT NULL,\n    sequence       bigint NOT NULL,\n    event_sequence bigint NOT NULL,\n    payload        bytea  NOT NULL,\n    updated_at     timestamptz NOT NULL DEFAULT now()\n);\n\nCREATE TABLE IF NOT EXISTS orders__evt_features (\n    id                integer PRIMARY KEY,\n    version           bigint NOT NULL,\n    features          text   NOT NULL,\n    history_dependent text   NOT NULL DEFAULT '[]',\n    retention         text   NOT NULL DEFAULT '[]'\n);\n"
    },
    {
      "eventsTable": "evt_events",
      "snapshotsTable": "evt_snapshots",
      "ddl": "\nCREATE TABLE IF NOT EXISTS evt_events (\n    entity_id   text   NOT NULL,\n    sequence    bigint NOT NULL,\n    event_id    text   NOT NULL,\n    event_type  text   NOT NULL,\n    version     bigint NOT NULL,\n    entity_type text   NOT NULL,\n    payload     bytea  NOT NULL,\n    metadata    jsonb  NOT NULL DEFAULT '{}'::jsonb,\n    created_at  timestamptz NOT NULL DEFAULT now(),\n    PRIMARY KEY (entity_id, sequence)\n);\nCREATE INDEX IF NOT EXISTS evt_events__evt_entity_type_idx ON evt_events (entity_type);\nDO $$\nBEGIN\n    IF EXISTS (\n        SELECT 1 FROM pg_index\n        WHERE indexrelid = to_regclass('evt_events_entity_type_idx')\n          AND indrelid = 'evt_events'::regclass\n    ) THEN\n        DROP INDEX evt_events_entity_type_idx;\n    END IF;\nEND $$;\n\nCREATE TABLE IF NOT EXISTS evt_snapshots (\n    entity_id      text   PRIMARY KEY,\n    entity_type    text   NOT NULL,\n    sequence       bigint NOT NULL,\n    event_sequence bigint NOT NULL,\n    payload        bytea  NOT NULL,\n    updated_at     timestamptz NOT NULL DEFAULT now()\n);\n\nCREATE TABLE IF NOT EXISTS evt_events__evt_features (\n    id                integer PRIMARY KEY,\n    version           bigint NOT NULL,\n    features          text   NOT NULL,\n    history_dependent text   NOT NULL DEFAULT '[]',\n    retention         text   NOT NULL DEFAULT '[]'\n);\n"
    }
  ]
