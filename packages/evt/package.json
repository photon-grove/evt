{
  "name": "@photon-grove/evt",
  "version": "0.1.2",
  "description": "Event sourcing for TypeScript, wire-compatible with the Go and Rust evt implementations.",
  "keywords": [
    "event-sourcing",
    "cqrs",
    "dynamodb",
    "postgresql"
  ],
  "homepage": "https://github.com/photon-grove/evt/tree/main/packages/evt#readme",
  "bugs": "https://github.com/photon-grove/evt/issues",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/photon-grove/evt.git",
    "directory": "packages/evt"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.12"
  },
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dynamodb": {
      "types": "./dist/dynamodb/index.d.ts",
      "default": "./dist/dynamodb/index.js"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "default": "./dist/memory/index.js"
    },
    "./postgres": {
      "types": "./dist/postgres/index.d.ts",
      "default": "./dist/postgres/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-dynamodb": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json && oxlint --deny-warnings && node scripts/check-imports.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "3.1161.0",
    "@types/node": "^26.6.6",
    "oxlint": "1.90.0",
    "typescript": "^7.0.2",
    "vitest": "5.0.5"
  }
}
